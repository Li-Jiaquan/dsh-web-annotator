{
  "name": "@li-jiaquan/dsh-web-annotator",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "In-app web page annotation for DSH: annotate elements, areas and text in a proxied web page preview, then send structured comments to the agent.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Li-Jiaquan/dsh-web-annotator.git"
  },
  "homepage": "https://github.com/Li-Jiaquan/dsh-web-annotator#readme",
  "bugs": {
    "url": "https://github.com/Li-Jiaquan/dsh-web-annotator/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "web-annotation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./runtime": "./runtime.js",
    "./locale/*.json": "./locale/*.json",
    "./vendor/*": "./vendor/*",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "runtime.js",
    "cordis.patch.yml",
    "locale/*.json",
    "vendor/*",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md",
    "demo"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
